# Copy to .env and fill in paths

# Absolute path to the Unity Linux headless build directory
# The directory should contain the .x86_64 executable
UNITY_BUILD_PATH=/path/to/BlackOut_Linux

# Absolute path to your trainer code directory
# Should contain train.py and semantic_map_config.json
TRAINER_PATH=/path/to/my_trainer

# Absolute path to your competition directory
# Should contain run_competition.py, checkpoints, and will receive recording output
COMPETITION_PATH=/path/to/my_competition
